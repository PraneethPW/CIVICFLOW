PORT=4500
JWT_SECRET=
# SQLite is the default. For shared hosting, set a real PostgreSQL connection string.
DATABASE_URL=
DATA_DIR=data
UPLOAD_DIR=data/uploads
# Set both to provision the first admin. Changing these does not reset an existing account.
ADMIN_EMAIL=admin@civicflow.ai
ADMIN_PASSWORD=
FRONTEND_URL=http://localhost:5173
# Comma-separated extra browser origins (for LAN development or a hosted frontend).
CORS_ORIGINS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
